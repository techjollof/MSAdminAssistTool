#>

#---------------------------------------------------------[Initialisations]--------------------------------------------------------

#Set Error Action to Silently Continue
$ErrorActionPreference = "SilentlyContinue"

#Dot Source required Function Libraries
. "C:\Scripts\Functions\Logging_Functions.ps1"

#----------------------------------------------------------[Declarations]----------------------------------------------------------
#clear powershell script window
Clear-Host

#Script Version
$sScriptVersion = "1.5"
#Script Name
$sScriptName = "PasswordExpiry"

#Log File Info
$sLogPath = "C:\Scripts\Logs"
$sLogName = $sScriptName + " - " + (Get-Date -f "yyyy-MM-dd") + ".log"
$sLogFile = Join-Path -Path $sLogPath -ChildPath $sLogName


#Initalise Variables
$today = Get-Date
$users = ""
$expiryDate = ""
$daysLeft = ""
$DisplayName =""
$ReportDate=""
$Days= "3"
$SearchBase=$null
$ReportPath = "C:\Scripts\Reports"
$From="alerts@domain.co.nz"
$To=""
$Subject="Urgent Action Required - Password due to Expire"
$SMTPServer="smtp.domain.co.nz"
$SMTPBODY=$null

#Define Parameters
Param (
	[Parameter(Mandatory=$False,Position=1)][string]$SearchBase,
    [Parameter(Mandatory=$False,Position=2)][string]$ReportPath,
    [Parameter(Mandatory=$False,Position=3)][string]$Days ,
    [Parameter(Mandatory=$False,Position=4)][string]$From,
	[Parameter(Mandatory=$False,Position=5)][string]$To,
    [Parameter(Mandatory=$False,Position=6)][string]$Subject,
	[Parameter(Mandatory=$False,Position=7)][string]$SMTPServer
)


#-----------------------------------------------------------[Functions]------------------------------------------------------------

function DueToExpire #This function loops through valid users and emails user with passwords expiring in the number of days specified in $Days
{
    #Read all user accounts whos accounts are enable and have email addresses into variable
    if ($SearchBase -eq $null)
    {
        $users=Get-ADUser -filter {Enabled -eq $True -and PasswordNeverExpires -eq $False -and mail -like "*"} –Properties “DisplayName”, "EmailAddress", “msDS-UserPasswordExpiryTimeComputed” | Select-Object -Property “Displayname”,"EmailAddress",@{Name=“ExpiryDate”;Expression={[datetime]::FromFileTime($_.“msDS-UserPasswordExpiryTimeComputed”)}} 
    }
    else
    {
        $users=Get-ADUser -SearchBase $SearchBase -filter {Enabled -eq $True -and PasswordNeverExpires -eq $False -and mail -like "*"} –Properties “DisplayName”, "EmailAddress", “msDS-UserPasswordExpiryTimeComputed” | Select-Object -Property “Displayname”,"EmailAddress",@{Name=“ExpiryDate”;Expression={[datetime]::FromFileTime($_.“msDS-UserPasswordExpiryTimeComputed”)}} 
    }
    

    #Produce a CSV Report of password Expiry dates for all vaild accounts
    $ReportDate = Get-Date -f "yyyy-MM-dd"
    $users | Export-Csv -InputObject $ReportPath\$sScriptName-$ReportDate.csv -NoTypeInformation

    #loop though each $user.$users
    foreach ($user in $users){

    #Populate variables
    $DisplayName = $user.DisplayName
    $emailaddy=$user.EmailAddress
    $To= $user.EmailAddress
    $expiryDate = $user.ExpiryDate
    $daysLeft = $expiryDate - $today
    #Write-Output -InputObject $DisplayName, " password will expire in ", $daysLeft.days #Uncomment to display output in powershell Window for testing
        if ($daysLeft.Days -le $Days -and $daysLeft.Days -gt 0)
        {
        #Write-Output $emailaddy #uncomment to display list of emailed users in PS Window for testing
        $SMTPBODY = "" + $DisplayName + ", Your password will expire in " + $daysLeft.days + " days! Please change as soon as possible within the next 24 hours to ensure access to all organisational Systems."
        Send-MailMessage -From $From -Subject $Subject -To $To -Body ($SMTPBODY | out-string) -SmtpServer $SMTPServer
        Log-Write -LogPath $sLogFile -LineValue $DisplayName
        }
    }
}

function CleanUpHistory #This Function scans the Log and Report folders and deletes any file over 7 days
{
$limit = (Get-Date).AddDays(-7)

# Delete files older than the $limit.
Get-ChildItem -Path $ReportPath -Recurse -Force | Where-Object { !$_.PSIsContainer -and $_.CreationTime -lt $limit } | Remove-Item -Force #Clean up CVS Reports
Get-ChildItem -Path $sLogPath -Recurse -Force | Where-Object { !$_.PSIsContainer -and $_.CreationTime -lt $limit } | Remove-Item -Force #Clean up Logs
}

#-----------------------------------------------------------[Execution]------------------------------------------------------------

Log-Start -LogPath $sLogPath -LogName $sLogName -ScriptVersion $sScriptVersion #Start Logging

Log-Write -LogPath $sLogFile -LineValue "Checking for Users with passwords due to Expire" #Write to Log
Log-Write -LogPath $sLogFile -LineValue "The Following Users have been emailed advising them to change their password" #Write to Log

DueToExpire #Run function

Log-Write -LogPath $sLogFile -LineValue "Cleaning up Reports and Logs over 7 days" #Write to Log

CleanUpHistory #Run function

Log-Finish -LogPath $sLogFile #Finish Logging
